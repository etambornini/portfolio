---
import Proyectos from "../../components/proyectos/proyectos.astro";
import Layout from "../../layouts/layout.astro";
import BlockSlider from "../../components/blocks/BlockSlider.jsx";
import BlockRichText from "../../components/blocks/BlockRichText.astro";

const { slug } = Astro.params;

const res = await fetch(`http://localhost:1337/api/portfolios?filters[slug]=${slug}&populate[cover][populate]=*&populate[block][populate]=*`);
const data = await res.json();

const proyecto = data?.data?.[0];

const seoBlock = proyecto?.block?.find(b => b.__component === "shared.seo");
const metaTitle = seoBlock?.metaTitle ?? proyecto?.name;
const metaDescription = seoBlock?.metaDescription ?? proyecto?.description;
const ogImage = seoBlock?.shareImage?.url
  ? `http://localhost:1337${seoBlock.shareImage.formats?.medium?.url || seoBlock.shareImage.url}`
  : null;
---

{!proyecto ? (
  <>
  <head>
    <title>Proyecto no encontrado</title>
    <meta name="description" content="Proyecto no encontrado" />
  </head>
  <Layout title="Proyecto no encontrado">
			<div class="flex flex-col items-center justify-center h-screen ">
					<div class="flex flex-col items-center justify-center">
						<img src="/favicon.svg" alt="Logo" class="w-24 h-24 mb-4 invert" />
							<p class="font-neue-semi   text-md sm:text-lg ">Elias Tambornini</p>
					</div>
					<p class="text-center  ">Por favor, verifica el nombre del proyecto o intenta con otro.</p>
					</div>
  </Layout>
  </>
) : (
  <>
  <head>
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://etambornini.com/portfolio/${slug}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDescription} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
  </head>
  <Layout title={`Proyecto - ${slug}`}>
    <div class="flex flex-col items-center justify-center h-screen ">
      <div class="flex flex-col items-center justify-center">
        <img src="/favicon.svg" alt="Logo" class="w-24 h-24 mb-4" />
        <p class="font-neue-semi  text-md sm:text-lg">Elias Tambornini</p>
      </div>
      <h1 class="font-neue-semi text-4xl sm:text-6xl md:text-6xl lg:text-8xl   uppercase">
        {proyecto.name || slug}
      </h1>
    </div>

   

    <div class="flex gap-4 flex-wrap justify-center mt-8">
     <div class="flex flex-col gap-12 py-16 px-4 sm:px-12">
  {proyecto.block.map((bloque) => {
    if (bloque.__component === "shared.slider") {
      return <BlockSlider files={bloque.files} client:load />;
    }
    if (bloque.__component === "shared.rich-text") {
      return <BlockRichText body={bloque.body} />;
    }
    return null;
  		})}
</div>
    </div>
  </Layout>
  </>
)}