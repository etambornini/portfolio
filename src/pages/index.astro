---
import ImageTiltCard from "../components/proyectos/ImageTiltCard";
import Section from "../components/sections/section.astro";
import ProjectsSection from "../components/sections/ProjectsSection.astro";

import Layout from "../layouts/layout.astro";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>E. Tambornini - Portfolio</title>
	</head>
	<body>
		<Layout>
			<div class="flex flex-col items-center justify-center h-screen ">
					<div class="flex flex-col items-center justify-center">
						<img src="/favicon.svg" alt="Logo" class="w-24 h-24 mb-4" />
							<p class="font-neue-semi  text-md sm:text-lg ">Elias Tambornini</p>
					</div>
		<h1 class="font-neue-semi text-6xl sm:text-6xl md:text-6xl lg:text-8xl text-center uppercase">Portfolio Digital</h1>
			</div>
			<div class="md:px-40">
			<Section/>
			</div>
			<ProjectsSection/>
		</Layout>
	</body>
</html>
